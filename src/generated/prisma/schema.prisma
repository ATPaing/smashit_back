generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id               Int      @id @default(autoincrement())
  name             String
  email            String   @unique
  passwordHash     String
  reliabilityScore Int      @default(100)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
